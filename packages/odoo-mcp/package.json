{
  "name": "@marcfargas/odoo-mcp",
  "version": "0.0.1",
  "description": "MCP server for safe, policy-governed access to Odoo",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "odoo-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "lint": "eslint src tests --ext .ts",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config ../../vitest.integration.config.mts",
    "postbuild": "node -e \"require('fs').chmodSync('dist/index.js',0o755)\""
  },
  "keywords": [
    "odoo",
    "mcp",
    "model-context-protocol",
    "erp",
    "typescript"
  ],
  "author": "Marc Fargas <marc@marcfargas.com>",
  "license": "LGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcfargas/odoo-toolbox.git",
    "directory": "packages/odoo-mcp"
  },
  "dependencies": {
    "@marcfargas/odoo-client": "^0.4.2",
    "@marcfargas/odoo-introspection": "^0.1.3",
    "@modelcontextprotocol/sdk": "1.27.1",
    "debug": "^4.3.4",
    "express": "^4.18.0"
  },
  "devDependencies": {
    "@types/debug": "^4.1.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  },
  "publishConfig": {
    "access": "public"
  }
}
